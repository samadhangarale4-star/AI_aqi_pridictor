                          : 'bg-white/25 text-slate-800'
                      }`}>
                        <Icon className="w-5 h-5 sm:w-6 sm:h-6" />
                      </div>
                      <span className={`text-[10px] uppercase font-mono font-bold tracking-wider px-2 py-0.5 rounded-full ${
                        isActive 
                          ? 'bg-teal-500/15 text-teal-800 border border-teal-500/30' 
                          : 'bg-white/30 text-slate-700'
                      }`}>
                        {tab.badge}
                      </span>
                    </div>

                    <div className="w-full">
                      <div className="text-base sm:text-lg font-black leading-tight tracking-tight text-slate-950">
                        {tab.label}
                      </div>
                      <div className={`text-[11px] sm:text-xs font-semibold mt-0.5 leading-snug line-clamp-1 ${
                        isActive ? 'text-slate-600' : 'text-slate-700'
                      }`}>
                        {tab.desc}
                      </div>
                    </div>
                  </motion.button>
                );
              })}
            </div>

            {/* Active View Quick Bar */}
            {dashboardTab !== 'all' && (
              <div className="mt-3 pt-3 border-t border-white/30 flex items-center justify-between text-xs text-slate-800 font-medium">
                <div className="flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-teal-600 animate-ping" />
                  <span>Filtered View: <strong className="font-extrabold text-slate-950 capitalize">{dashboardTab}</strong></span>
                </div>
                <button
                  type="button"
                  onClick={() => setDashboardTab('all')}
                  className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/40 hover:bg-white/60 text-slate-900 font-bold transition-all cursor-pointer text-xs"
                >
                  <Layers className="w-3.5 h-3.5 text-teal-700" />
                  <span>Show Full Suite (All Views)</span>
                </button>
              </div>
            )}
          </div>
        </div>

        {/* Prediction Results */}
        {forecastResult && overallConfig && analyticsSummary && (
          <main className="space-y-6">
            
            {/* 1. ANALYTICS & CHARTS TAB CONTENT */}

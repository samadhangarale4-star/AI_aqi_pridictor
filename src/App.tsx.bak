                      </p>
                    </div>

                    {/* BIG PROPER Graph Tab Switcher */}
                    <div className="inline-flex p-1.5 sm:p-2 rounded-2xl bg-white/20 backdrop-blur-2xl text-sm shrink-0 gap-2 border border-white/30 shadow-lg">
                      <button
                        type="button"
                        onClick={() => setActiveChartTab('timeline')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer flex items-center gap-2 font-bold text-xs sm:text-sm ${
                          activeChartTab === 'timeline'
                            ? 'bg-teal-600 text-white shadow-md'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        <LineChartIcon className="w-4 h-4 sm:w-5 sm:h-5" />
                        <span>Progression Curve</span>
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveChartTab('diurnal')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer flex items-center gap-2 font-bold text-xs sm:text-sm ${
                          activeChartTab === 'diurnal'
                            ? 'bg-indigo-600 text-white shadow-md'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        <BarChart3 className="w-4 h-4 sm:w-5 sm:h-5" />
                        <span>Diurnal Compare</span>
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveChartTab('pollutants')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer flex items-center gap-2 font-bold text-xs sm:text-sm ${
                          activeChartTab === 'pollutants'
                            ? 'bg-purple-600 text-white shadow-md'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        <Layers className="w-4 h-4 sm:w-5 sm:h-5" />
                        <span>Pollutant Profiles</span>
                      </button>
                    </div>
                  </div>

                  {/* Chart 1: 48-Hour Continuous Progression Line Chart */}
                  {activeChartTab === 'timeline' && (
                    <div className="w-full">
                      <div className="h-[280px] w-full">
                        <ResponsiveContainer width="100%" height="100%">
                          <AreaChart
                            data={timelineChartData}
                            margin={{ top: 12, right: 12, left: -16, bottom: 0 }}
                            // eslint-disable-next-line @typescript-eslint/no-explicit-any
                            onClick={(e: any) => {
                              if (e && e.activePayload && e.activePayload[0]) {
                                const point = e.activePayload[0].payload as ChartPoint;
                                const slot = forecastResult.days[point.dayIndex]?.timeSlots.find(
                                  (s) => s.id === point.slotId
                                );
                                if (slot) handleSelectSlot(slot);
                              }
                            }}
                          >
                            <defs>
                              <linearGradient id="vibrantAqiGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="5%" stopColor="#0284c7" stopOpacity={0.35} />
                                <stop offset="50%" stopColor="#0d9488" stopOpacity={0.15} />
                                <stop offset="95%" stopColor="#10b981" stopOpacity={0.02} />
                              </linearGradient>
                            </defs>
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                            <XAxis
                              dataKey="shortLabel"
                              tick={{ fontSize: 10, fill: '#64748b', fontFamily: 'monospace', fontWeight: 600 }}
                              axisLine={{ stroke: '#cbd5e1' }}
                              tickLine={false}
                            />
                            <YAxis
                              tick={{ fontSize: 10, fill: '#64748b', fontFamily: 'monospace' }}
                              axisLine={false}
                              tickLine={false}
                              domain={[0, (dataMax: number) => Math.max(120, Math.ceil(dataMax / 25) * 25 + 15)]}
                            />
                            <Tooltip content={<CustomTimelineTooltip />} />
                            <ReferenceLine
                              y={50}
                              stroke="#10b981"
                              strokeDasharray="4 4"
                              strokeWidth={1.5}
                              label={{ value: 'Good (50)', fill: '#059669', fontSize: 10, fontWeight: 700, position: 'right' }}
                            />
                            <ReferenceLine
                              y={100}
                              stroke="#f59e0b"
                              strokeDasharray="4 4"
                              strokeWidth={1.5}
                              label={{ value: 'Moderate (100)', fill: '#d97706', fontSize: 10, fontWeight: 700, position: 'right' }}
                            />
                            <ReferenceLine
                              y={150}
                              stroke="#f97316"
                              strokeDasharray="4 4"
                              strokeWidth={1.5}
                              label={{ value: 'Unhealthy (150)', fill: '#ea580c', fontSize: 10, fontWeight: 700, position: 'right' }}
                            />
                            <Area
                              type="monotone"
                              dataKey="aqi"
                              stroke="#0284c7"
                              strokeWidth={2.5}
                              fillOpacity={1}
                              fill="url(#vibrantAqiGrad)"
                              activeDot={{ r: 6, fill: '#0369a1', stroke: '#fff', strokeWidth: 2 }}
                            />
                          </AreaChart>
                        </ResponsiveContainer>
                      </div>
                      <div className="flex flex-wrap items-center justify-between gap-2 mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 font-mono">
                        <span className="flex items-center gap-1.5 font-semibold text-sky-700">
                          <span className="w-3 h-1 bg-sky-600 rounded-full inline-block" />
                          Predicted AQI Continuous Curve
                        </span>
                        <span className="text-slate-400">
                          Color Thresholds: <strong className="text-emerald-600">50 Good</strong> • <strong className="text-amber-600">100 Moderate</strong> • <strong className="text-orange-600">150 Sensitive</strong>
                        </span>
                      </div>
                    </div>
                  )}

                  {/* Chart 2: Diurnal Comparison (Day 1 vs Day 2 by Time Slot) */}
                  {activeChartTab === 'diurnal' && (
                    <div className="w-full">
                      <div className="h-[280px] w-full">
                        <ResponsiveContainer width="100%" height="100%">
                          <BarChart
                            data={diurnalComparisonData}
                            margin={{ top: 12, right: 12, left: -16, bottom: 0 }}
                          >
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                            <XAxis
                              dataKey="time"
                              tick={{ fontSize: 10, fill: '#64748b', fontFamily: 'monospace', fontWeight: 600 }}
                              axisLine={{ stroke: '#cbd5e1' }}
                              tickLine={false}
                            />
                            <YAxis
                              tick={{ fontSize: 10, fill: '#64748b', fontFamily: 'monospace' }}
                              axisLine={false}
                              tickLine={false}
                              domain={[0, (dataMax: number) => Math.max(120, Math.ceil(dataMax / 25) * 25 + 15)]}
                            />
                            <Tooltip
                              // eslint-disable-next-line @typescript-eslint/no-explicit-any
                              formatter={(value: any, name: any) => [
                                `${value} AQI`,
                                name === 'day1Aqi' ? 'Day 1 (Tomorrow)' : 'Day 2 (Day After)',
                              ]}
                              contentStyle={{
                                backgroundColor: '#fff',
                                borderColor: '#cbd5e1',
                                borderRadius: '8px',
                                fontSize: '12px',
                                fontFamily: 'monospace',
                                boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)',
                              }}
                            />
                            <Legend
                              wrapperStyle={{ fontSize: '11px', fontFamily: 'monospace', paddingTop: '8px', fontWeight: 600 }}
                              formatter={(value) => (value === 'day1Aqi' ? 'Day 1 (Tomorrow)' : 'Day 2 (Day After)')}
                            />
                            <Bar dataKey="day1Aqi" fill="#3b82f6" radius={[4, 4, 0, 0]} maxBarSize={32} />
                            <Bar dataKey="day2Aqi" fill="#10b981" radius={[4, 4, 0, 0]} maxBarSize={32} />
                          </BarChart>
                        </ResponsiveContainer>
                      </div>
                      <div className="mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 font-mono text-center">
                        Direct diurnal rush-hour alignment: compares identical clock periods (<span className="text-blue-600 font-bold">Day 1 Blue</span> vs <span className="text-emerald-600 font-bold">Day 2 Green</span>)
                      </div>
                    </div>
                  )}

                  {/* Chart 3: Pollutant Profiles & Dominance Breakdown */}
                  {activeChartTab === 'pollutants' && (
                    <div className="w-full">
                      <div className="h-[280px] w-full">
                        <ResponsiveContainer width="100%" height="100%">
                          <BarChart
                            data={pollutantAnalyticsData}
                            margin={{ top: 12, right: 12, left: -16, bottom: 0 }}
                          >
                            <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                            <XAxis
                              dataKey="pollutant"
                              tick={{ fontSize: 11, fill: '#334155', fontFamily: 'monospace', fontWeight: 'bold' }}
                              axisLine={{ stroke: '#cbd5e1' }}
                              tickLine={false}
                            />
                            <YAxis
                              tick={{ fontSize: 10, fill: '#64748b', fontFamily: 'monospace' }}
                              axisLine={false}
                              tickLine={false}
                            />
                            <Tooltip
                              // eslint-disable-next-line @typescript-eslint/no-explicit-any
                              formatter={(value: any, name: any) => [
                                name === 'avgAqi' ? `${value} AQI` : `${value} Hours`,
                                name === 'avgAqi' ? 'Average Index Level' : 'Dominant Frequency (Hours)',
                              ]}
                              contentStyle={{
                                backgroundColor: '#fff',
                                borderColor: '#cbd5e1',
                                borderRadius: '8px',
                                fontSize: '12px',
                                fontFamily: 'monospace',
                                boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)',
                              }}
                            />
                            <Legend
                              wrapperStyle={{ fontSize: '11px', fontFamily: 'monospace', paddingTop: '8px', fontWeight: 600 }}
                              formatter={(value) => (value === 'avgAqi' ? 'Average AQI When Dominant' : 'Slot Frequency Count')}
                            />
                            <Bar dataKey="avgAqi" fill="#8b5cf6" radius={[4, 4, 0, 0]} maxBarSize={38} />
                            <Bar dataKey="frequency" fill="#06b6d4" radius={[4, 4, 0, 0]} maxBarSize={38} />
                          </BarChart>
                        </ResponsiveContainer>
                      </div>
                      <div className="mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 font-mono text-center">
                        Particle composition profile across <strong className="text-rose-600">PM2.5</strong>, <strong className="text-amber-600">NO2</strong>, <strong className="text-sky-600">O3</strong>, and <strong className="text-teal-600">PM10</strong> classifications
                      </div>
                    </div>
                  )}
                </section>
              </>
            )}

            {/* 2. TIMELINE SCRUBBER TAB CONTENT */}
            {(dashboardTab === 'all' || dashboardTab === 'scrubber') && (
              <section className="bg-slate-950/40 backdrop-blur-2xl text-white rounded-3xl p-5 sm:p-6 shadow-2xl border border-white/20">
                <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                  <div className="flex items-center gap-2.5">
                    <Hand className="w-5 h-5 text-teal-400 animate-bounce" />
                    <div>
                      <h3 className="text-base font-extrabold uppercase tracking-wider flex items-center gap-2 text-white">
                        <span>48-Hour Gesture Timeline Scrubber</span>
                        <span className="text-[10px] bg-teal-500/30 text-teal-300 border border-teal-500/40 px-2 py-0.5 rounded-full font-normal">
                          Drag or Scrub
                        </span>
                      </h3>
                      <p className="text-xs text-slate-300">
                        Drag across time slots to scrub through atmospheric conditions & gauge readings
                      </p>
                    </div>
                  </div>

                  {/* Player Controls */}
                  <div className="flex items-center gap-2">
                    <motion.button
                      whileTap={{ scale: 0.92 }}
                      type="button"
                      onClick={() => setIsPlayingTimeline(!isPlayingTimeline)}
                      className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs shadow-md transition-colors cursor-pointer backdrop-blur-sm"
                    >
                      {isPlayingTimeline ? (
                        <>
                          <Pause className="w-4 h-4" />
                          <span>Pause Simulation</span>
                        </>
                      ) : (
                        <>
                          <Play className="w-4 h-4" />
                          <span>Play 48h Timeline</span>
                        </>
                      )}
                    </motion.button>
                    <motion.button
                      whileTap={{ scale: 0.9 }}
                      type="button"
                      onClick={() => {
                        setScrubberIndex(0);
                        handleScrubberChange(0);
                      }}
                      className="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-slate-200 transition-colors cursor-pointer border border-white/10 backdrop-blur-sm"
                      title="Reset to 1st slot"
                    >
                      <RotateCcw className="w-4 h-4" />
                    </motion.button>
                  </div>
                </div>

                {/* Scrubber Gauge Status Bar */}
                {activeScrubPoint && activeScrubConfig && (
                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4 bg-white/10 backdrop-blur-md p-3 rounded-2xl border border-white/15 shadow-inner">
                    <div>
                      <div className="text-[10px] text-slate-300 font-mono uppercase">Scrubbed Window</div>
                      <div className="text-sm font-bold text-white font-mono mt-0.5">{activeScrubPoint.fullLabel}</div>
                    </div>
                    <div>
                      <div className="text-[10px] text-slate-300 font-mono uppercase">Predicted AQI</div>
                      <div className="text-base font-extrabold text-white font-mono flex items-center gap-1.5 mt-0.5">
                        <span>{activeScrubPoint.aqi} AQI</span>
                        <span className={`w-2 h-2 rounded-full ${activeScrubConfig.dotColor}`} />
                      </div>
                    </div>
                    <div>
                      <div className="text-[10px] text-slate-300 font-mono uppercase">Severity Tier</div>
                      <div className="text-xs font-bold text-teal-300 mt-0.5 truncate">{activeScrubPoint.category}</div>
                    </div>
                    <div>
                      <div className="text-[10px] text-slate-300 font-mono uppercase">Primary Particle</div>
                      <div className="text-xs font-bold text-amber-300 font-mono mt-0.5">{activeScrubPoint.pollutant} ({activeScrubPoint.temperature})</div>
                    </div>
                  </div>
                )}

                {/* Range Slider Scrubber Gesture Track */}
                <div className="space-y-2">
                  <input
                    type="range"
                    min={0}
                    max={timelineChartData.length - 1}
                    step={1}
                    value={scrubberIndex}
                    onChange={(e) => handleScrubberChange(Number(e.target.value))}
                    className="w-full h-3 bg-slate-700/80 rounded-lg appearance-none cursor-pointer accent-teal-400"
                  />

                  {/* 10 Step Notch Buttons */}
                  <div className="grid grid-cols-5 sm:grid-cols-10 gap-1 text-[10px] font-mono text-center">
                    {timelineChartData.map((pt, idx) => {
                      const isSelected = idx === scrubberIndex;
                      const catCfg = AQI_CATEGORIES[pt.category];
                      return (
                        <motion.button
                          key={pt.slotId}
                          whileHover={{ scale: 1.08 }}
                          whileTap={{ scale: 0.92 }}
                          type="button"
                          onClick={() => handleScrubberChange(idx)}
                          className={`py-1.5 px-1 rounded-xl transition-all cursor-pointer truncate ${
                            isSelected
                              ? 'bg-teal-400 text-slate-950 font-black ring-2 ring-white shadow-lg'
                              : 'bg-white/10 text-slate-200 hover:bg-white/20 backdrop-blur-xs border border-white/10'
                          }`}
                        >
                          <div className="text-[9px] opacity-75">{idx < 5 ? 'D1' : 'D2'}</div>
                          <div className="font-semibold">{pt.time.replace(':00 ', '')}</div>
                          <div className="text-[9px] flex items-center justify-center gap-1 mt-0.5">
                            <span className={`w-1.5 h-1.5 rounded-full ${catCfg.dotColor}`} />
                            <span>{pt.aqi}</span>
                          </div>
                        </motion.button>
                      );
                    })}
                  </div>
                </div>
              </section>
            )}

            {/* 3. HOURLY FORECAST TAB CONTENT */}
            {(dashboardTab === 'all' || dashboardTab === 'forecast') && (
              <>
                {/* Interactive Day Filter & View Switcher - BIG PROPER TABS */}
                <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pt-1">
                  {/* Day filter tabs */}
                  <div className="flex flex-wrap items-center gap-2">
                    <div className="inline-flex p-1.5 sm:p-2 rounded-2xl bg-white/20 backdrop-blur-2xl text-sm border border-white/30 shadow-lg gap-2">
                      <button
                        type="button"
                        onClick={() => setActiveDayFilter('both')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer font-bold text-xs sm:text-sm ${
                          activeDayFilter === 'both'
                            ? 'bg-white text-slate-900 shadow-md font-extrabold'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        Both Days (10 Slots)
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveDayFilter(0)}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer font-bold text-xs sm:text-sm ${
                          activeDayFilter === 0
                            ? 'bg-teal-600 text-white shadow-md font-extrabold'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        Day 1 (Tomorrow)
                      </button>
                      <button
                        type="button"
                        onClick={() => setActiveDayFilter(1)}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer font-bold text-xs sm:text-sm ${
                          activeDayFilter === 1
                            ? 'bg-indigo-600 text-white shadow-md font-extrabold'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        Day 2 (Day After)
                      </button>
                    </div>

                    <div className="hidden sm:flex items-center gap-1.5 text-xs text-slate-800 bg-white/20 backdrop-blur-md px-3 py-2 rounded-xl border border-white/30 font-semibold shadow-xs">
                      <ArrowLeft className="w-3.5 h-3.5 text-slate-600" />
                      <span>Swipe cards</span>
                      <ArrowRight className="w-3.5 h-3.5 text-slate-600" />
                    </div>
                  </div>

                  {/* Layout Switcher (Cards / Table) */}
                  <div className="flex items-center gap-2">
                    <span className="text-xs sm:text-sm text-slate-800 font-bold uppercase tracking-wide">Format:</span>
                    <div className="inline-flex p-1.5 sm:p-2 rounded-2xl bg-white/20 backdrop-blur-2xl text-sm border border-white/30 shadow-lg gap-2">
                      <button
                        type="button"
                        onClick={() => setViewMode('cards')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer font-bold text-xs sm:text-sm ${
                          viewMode === 'cards'
                            ? 'bg-white text-slate-900 shadow-md font-extrabold'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        Card Grid
                      </button>
                      <button
                        type="button"
                        onClick={() => setViewMode('table')}
                        className={`px-4 sm:px-5 py-2.5 rounded-xl transition-all cursor-pointer font-bold text-xs sm:text-sm ${
                          viewMode === 'table'
                            ? 'bg-white text-slate-900 shadow-md font-extrabold'
                            : 'text-slate-800 hover:text-slate-950 hover:bg-white/20'
                        }`}
                      >
                        Data Table
                      </button>
                    </div>
                  </div>
                </div>

                {/* EPA AQI Legend */}
                <div className="bg-white/15 backdrop-blur-2xl rounded-3xl border border-white/30 p-5 shadow-2xl shadow-sky-950/15 text-xs">
                  <div className="flex items-center justify-between mb-2.5">
                    <span className="text-[11px] font-mono uppercase tracking-wider font-bold text-slate-700 flex items-center gap-1.5">
                      <span className="w-2 h-2 rounded-full bg-teal-500" />
                      EPA Index Scale Spectrum (Click to filter slots)
                    </span>
                    {highlightCategory && (
                      <button
                        type="button"
                        onClick={() => setHighlightCategory(null)}
                        className="text-[11px] text-teal-700 hover:text-teal-900 font-bold underline cursor-pointer"
                      >
                        Reset Filter
                      </button>
                    )}
                  </div>
                  <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
                    {Object.values(AQI_CATEGORIES).map((cat) => {
                      const isFiltered = highlightCategory === cat.name;
                      return (
                        <motion.button
                          whileHover={{ scale: 1.04 }}
                          whileTap={{ scale: 0.95 }}
                          key={cat.name}
                          type="button"
                          onClick={() => setHighlightCategory(isFiltered ? null : cat.name)}
                          className={`p-2.5 rounded-xl border text-left transition-all cursor-pointer backdrop-blur-md ${
                            cat.badgeBg
                          } ${cat.badgeBorder} ${
                            isFiltered
                              ? 'ring-2 ring-slate-900 shadow-md font-bold'
                              : 'hover:shadow-2xs'
                          }`}
                        >
                          <div className="flex items-center gap-1.5 font-bold text-xs mb-1">
                            <span className={`w-2 h-2 rounded-full ring-1 ring-white ${cat.dotColor}`} />
                            <span className={cat.badgeText}>{cat.name}</span>
                          </div>
                          <div className="font-mono text-slate-700 font-bold text-[11px]">{cat.min}–{cat.max} AQI</div>
                        </motion.button>
                      );
                    })}
                  </div>
                </div>

                {/* Card Layout with SWIPE GESTURE SUPPORT */}
                {viewMode === 'cards' && (
                  <motion.div
                    drag="x"
                    dragConstraints={{ left: 0, right: 0 }}
                    onDragEnd={handleSwipeEnd}
                    className={`grid grid-cols-1 ${displayedDays.length > 1 ? 'md:grid-cols-2' : ''} gap-5 touch-pan-y cursor-grab active:cursor-grabbing`}
                  >
                    {displayedDays.map((day, dayIndex) => {
                      const dayCatConfig = AQI_CATEGORIES[day.category];
                      const dayTheme = dayIndex === 0 ? 'border-t-teal-500' : 'border-t-indigo-500';

                      return (
                        <motion.div
                          layout
                          initial={{ opacity: 0, scale: 0.98 }}
                          animate={{ opacity: 1, scale: 1 }}
                          transition={{ duration: 0.2 }}
                          key={day.dayTitle}
                          className={`bg-white/15 backdrop-blur-2xl rounded-3xl border border-white/30 border-t-4 ${dayTheme} overflow-hidden shadow-2xl shadow-sky-950/15 flex flex-col`}
                        >
                          {/* Day Header */}
                          <div className="px-5 py-3.5 border-b border-white/25 bg-white/10 backdrop-blur-md flex items-center justify-between">
                            <div>
                              <div className="flex items-center gap-1.5 text-xs font-mono font-bold text-slate-700 uppercase">
                                <Calendar className="w-3.5 h-3.5 text-slate-500" />
                                <span>{day.dayTitle}</span>
                              </div>
                              <div className="text-sm font-extrabold text-slate-900 mt-0.5">
                                {day.dateFormatted}
                              </div>
                            </div>

                            <div className="text-right">
                              <span className={`inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full border ${dayCatConfig.badgeBg} ${dayCatConfig.badgeBorder} ${dayCatConfig.badgeText} font-bold shadow-2xs backdrop-blur-md`}>
                                <span className={`w-2 h-2 rounded-full ${dayCatConfig.dotColor}`} />
                                {day.category}
                              </span>
                              <div className="text-[11px] font-mono text-slate-700 mt-1">
                                Day Mean: <strong className="text-slate-900">{day.averageAqi} AQI</strong>
                              </div>
                            </div>
                          </div>

                          {/* Exactly 5 Time Slots / Day */}
                          <div className="p-3.5 space-y-2 flex-1">
                            {day.timeSlots.map((slot) => {
                              const slotConfig = AQI_CATEGORIES[slot.category];
                              const pollConfig = POLLUTANT_COLORS[slot.mainPollutant] || { bg: 'bg-slate-100', text: 'text-slate-800', border: 'border-slate-200' };
                              const isSelected = selectedSlot?.id === slot.id;
                              const matchesFilter = !highlightCategory || slot.category === highlightCategory;

                              return (
                                <motion.div
                                  whileHover={{ scale: 1.015, x: 2 }}
                                  whileTap={{ scale: 0.98 }}
                                  key={slot.id}
                                  role="button"
                                  tabIndex={0}
                                  onClick={() => handleSelectSlot(slot)}
                                  onKeyDown={(e) => {
                                    if (e.key === 'Enter' || e.key === ' ') {
                                      handleSelectSlot(slot);
                                    }
                                  }}
                                  className={`py-2.5 px-3 rounded-xl border border-white/30 border-l-4 ${slotConfig.cardBorderL} transition-all cursor-pointer flex items-center justify-between text-sm ${
                                    isSelected
                                      ? 'bg-teal-500/25 backdrop-blur-md ring-2 ring-teal-400/80 shadow-md'
                                      : 'bg-white/20 hover:bg-white/35 backdrop-blur-md'
                                  } ${!matchesFilter ? 'opacity-35' : 'opacity-100'}`}
                                >
                                  {/* Time & Pollutant */}
                                  <div className="flex items-center gap-3">
                                    <Clock className={`w-4 h-4 ${isSelected ? 'text-teal-700' : 'text-slate-500'}`} />
                                    <div>
                                      <div className="font-mono font-bold text-slate-900">
                                        {slot.time}
                                      </div>
                                      <div className="text-[11px] text-slate-700 font-mono flex items-center gap-1.5 mt-0.5">
                                        <span className={`px-1.5 py-0.2 rounded text-[10px] font-bold border ${pollConfig.bg} ${pollConfig.text} ${pollConfig.border}`}>
                                          {slot.mainPollutant}
                                        </span>
                                        <span>• {slot.temperature}</span>
                                      </div>
                                    </div>
                                  </div>

                                  {/* Numeric AQI & Category Badge */}
                                  <div className="flex items-center gap-3">
                                    <div className="text-right">
                                      <span className="font-mono text-base font-extrabold text-slate-900">
                                        {slot.aqi}
                                      </span>
                                      <span className="font-mono text-[11px] text-slate-600 ml-1">AQI</span>
                                    </div>

                                    <span
                                      className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-xs font-bold w-26 justify-center shadow-2xs backdrop-blur-md ${slotConfig.badgeBg} ${slotConfig.badgeBorder} ${slotConfig.badgeText}`}
                                    >
                                      <span className={`w-1.5 h-1.5 rounded-full ${slotConfig.dotColor}`} />
                                      <span className="truncate">{slot.category}</span>
                                    </span>
                                  </div>
                                </motion.div>
                              );
                            })}
                          </div>

                          {/* Card Footer */}
                          <div className="px-5 py-2.5 bg-white/10 border-t border-white/25 text-xs text-slate-800 flex justify-between items-center font-mono">
                            <span>5 Standard Measurement Windows</span>
                            <span>Peak: <strong className="text-slate-900">{day.peakAqi} AQI</strong></span>
                          </div>
                        </motion.div>
                      );
                    })}
                  </motion.div>
                )}

                {/* Table Layout - Glassmorphic Transparent Table */}
                {viewMode === 'table' && (
                  <div className="bg-white/15 backdrop-blur-2xl rounded-3xl border border-white/30 overflow-hidden shadow-2xl shadow-sky-950/15">
                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-sm">
                        <thead>
                          <tr className="border-b border-white/25 bg-white/20 backdrop-blur-md text-[11px] font-mono text-slate-800 uppercase tracking-wider">
                            <th className="py-3 px-4 font-bold">Forecast Horizon</th>
                            <th className="py-3 px-4 font-bold">Scheduled Window</th>
                            <th className="py-3 px-4 font-bold">Predicted Index</th>
                            <th className="py-3 px-4 font-bold">Category Tier</th>
                            <th className="py-3 px-4 font-bold">Primary Pollutant</th>
                            <th className="py-3 px-4 font-bold">Est. Temp & Wind</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-white/25 text-slate-900">
                          {displayedDays.map((day, dayIndex) => (
                            <React.Fragment key={day.dayTitle}>
                              {day.timeSlots.map((slot, slotIndex) => {
                                const slotConfig = AQI_CATEGORIES[slot.category];
                                const pollConfig = POLLUTANT_COLORS[slot.mainPollutant] || { bg: 'bg-slate-100', text: 'text-slate-800', border: 'border-slate-200' };
                                const isSelected = selectedSlot?.id === slot.id;
                                const matchesFilter = !highlightCategory || slot.category === highlightCategory;

                                return (
                                  <tr 
                                    key={slot.id} 
                                    onClick={() => handleSelectSlot(slot)}
                                    className={`transition-colors cursor-pointer ${
                                      isSelected ? 'bg-teal-500/25 font-medium backdrop-blur-md' : 'hover:bg-white/25'
                                    } ${slotIndex === 0 && dayIndex > 0 ? 'border-t-2 border-white/30' : ''} ${
                                      !matchesFilter ? 'opacity-35' : 'opacity-100'
                                    }`}
                                  >
                                    {slotIndex === 0 ? (
                                      <td 
                                        rowSpan={5} 
                                        className="py-3 px-4 align-top font-bold text-slate-900 border-r border-white/25 bg-white/15 backdrop-blur-sm"
                                      >
                                        <div>{day.dayTitle}</div>
                                        <div className="text-xs text-slate-600 font-normal">{day.dateFormatted}</div>
                                        <div className="mt-2 text-xs font-mono text-slate-800">
                                          Mean: <span className="text-teal-700 font-bold">{day.averageAqi} AQI</span>
                                        </div>
                                      </td>
                                    ) : null}
                                    <td className="py-3 px-4 font-mono text-slate-900 font-bold">
                                      {slot.time}
                                    </td>
                                    <td className="py-3 px-4 font-mono">
                                      <span className="text-base font-extrabold text-slate-900">{slot.aqi}</span>
                                      <span className="text-xs text-slate-600 ml-1">AQI</span>
                                    </td>
                                    <td className="py-3 px-4">
                                      <span
                                        className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border text-xs font-bold backdrop-blur-md ${slotConfig.badgeBg} ${slotConfig.badgeBorder} ${slotConfig.badgeText}`}
                                      >
                                        <span className={`w-2 h-2 rounded-full ${slotConfig.dotColor}`} />
                                        {slot.category}
                                      </span>
                                    </td>
                                    <td className="py-3 px-4">
                                      <span className={`px-2 py-0.5 rounded text-xs font-bold border ${pollConfig.bg} ${pollConfig.text} ${pollConfig.border}`}>
                                        {slot.mainPollutant}
                                      </span>
                                    </td>
                                    <td className="py-3 px-4 text-xs font-mono text-slate-700">
                                      {slot.temperature} • {slot.windSpeed}
                                    </td>
                                  </tr>
                                );
                              })}
                            </React.Fragment>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </>
            )}

            {/* 4. SELECTED SLOT DETAILS INSPECTOR (Visible across all relevant tabs) */}
            <AnimatePresence mode="wait">
              {selectedSlot && (
                <motion.section 
                  key={selectedSlot.id}
                  initial={{ opacity: 0, y: 15 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -10 }}
                  transition={{ type: "spring", stiffness: 350, damping: 25 }}
                  className="bg-white/20 backdrop-blur-2xl rounded-3xl border border-white/30 p-5 shadow-2xl shadow-sky-950/15 border-l-4 border-l-teal-500"
                >
                  <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-white/30">
                    <div className="flex items-center gap-2.5">
                      <span className="w-2.5 h-2.5 rounded-full bg-teal-600 ring-2 ring-teal-200 animate-pulse" />
                      <span className="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">
                        Selected Slot Breakdown: {selectedSlot.time}
                      </span>
                      <span className={`text-xs px-2.5 py-0.5 rounded-full border font-bold backdrop-blur-md ${AQI_CATEGORIES[selectedSlot.category].badgeBg} ${AQI_CATEGORIES[selectedSlot.category].badgeBorder} ${AQI_CATEGORIES[selectedSlot.category].badgeText}`}>
                        {selectedSlot.aqi} AQI • {selectedSlot.category}
                      </span>
                    </div>
                    <span className="text-xs text-slate-700 italic flex items-center gap-1">
                      <Hand className="w-3.5 h-3.5 text-teal-600" />
                      <span>Drag timeline scrubber or click any slot to update</span>
                    </span>
                  </div>

                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3.5 text-xs">
                    <motion.div whileHover={{ scale: 1.02 }} className="p-3.5 rounded-2xl bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 shadow-xs">
                      <div className="flex items-center gap-1.5 text-rose-800 font-bold mb-1">
                        <Layers className="w-4 h-4 text-rose-600" />
                        <span>Dominant Agent</span>
                      </div>
                      <div className="font-mono text-base font-extrabold text-rose-950">{selectedSlot.mainPollutant}</div>
                      <div className="text-[11px] text-rose-800 mt-0.5">Primary driving particle</div>
                    </motion.div>

                    <motion.div whileHover={{ scale: 1.02 }} className="p-3.5 rounded-2xl bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 shadow-xs">
                      <div className="flex items-center gap-1.5 text-amber-800 font-bold mb-1">
                        <Thermometer className="w-4 h-4 text-amber-600" />
                        <span>Ambient Temp</span>
                      </div>
                      <div className="font-mono text-base font-extrabold text-amber-950">{selectedSlot.temperature}</div>
                      <div className="text-[11px] text-amber-800 mt-0.5">Surface level estimation</div>
                    </motion.div>

                    <motion.div whileHover={{ scale: 1.02 }} className="p-3.5 rounded-2xl bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 shadow-xs">
                      <div className="flex items-center gap-1.5 text-sky-800 font-bold mb-1">
                        <Droplets className="w-4 h-4 text-sky-600" />
                        <span>Relative Humidity</span>
                      </div>
                      <div className="font-mono text-base font-extrabold text-sky-950">{selectedSlot.humidity}</div>
                      <div className="text-[11px] text-sky-800 mt-0.5">Aerosol hygroscopy</div>
                    </motion.div>

                    <motion.div whileHover={{ scale: 1.02 }} className="p-3.5 rounded-2xl bg-white/20 hover:bg-white/30 backdrop-blur-md border border-white/30 shadow-xs">
                      <div className="flex items-center gap-1.5 text-teal-800 font-bold mb-1">
                        <Gauge className="w-4 h-4 text-teal-600" />
                        <span>Wind Velocity</span>
                      </div>
                      <div className="font-mono text-base font-extrabold text-teal-950">{selectedSlot.windSpeed}</div>
                      <div className="text-[11px] text-teal-800 mt-0.5">Horizontal transport</div>
                    </motion.div>
                  </div>

                  <div className="mt-3 pt-2.5 border-t border-white/30 text-xs text-slate-800 flex items-center gap-2">
                    <span className="font-mono font-bold text-teal-800">Atmospheric Context:</span>
                    <span>{selectedSlot.hourlyNote}.</span>
                  </div>
                </motion.section>
              )}
            </AnimatePresence>

            {/* 5. AI ADVISORY TAB CONTENT */}
            {(dashboardTab === 'all' || dashboardTab === 'advisory') && (
              <motion.section 
                whileHover={{ scale: 1.01 }}
                className="bg-white/20 backdrop-blur-2xl rounded-3xl border border-white/30 border-l-4 border-l-indigo-500 p-5 sm:p-6 shadow-2xl shadow-sky-950/15"
              >
                <div className="flex items-start gap-4">
                  <div className="p-2.5 rounded-xl bg-indigo-600/90 text-white shadow-md shadow-indigo-600/20 shrink-0 backdrop-blur-md">
                    <Sparkles className="w-5 h-5" />
                  </div>
                  <div className="flex-1">
                    <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <h3 className="text-base font-extrabold uppercase tracking-wider text-indigo-950 flex items-center gap-1.5">
                        AI Health Recommendation
                      </h3>
                      <span className="text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-950 border border-indigo-400/30 backdrop-blur-sm">
                        {forecastResult.recommendationSource === 'ai' ? 'Synthesized via Gemini AI' : 'Standard Epidemiological Advisory'}
                      </span>
                    </div>

                    <p className="text-sm text-slate-800 leading-relaxed font-normal">
                      {forecastResult.recommendation}
                    </p>

                    <div className="mt-4 pt-3 border-t border-white/30 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-700">
                      <div className="flex items-center gap-1.5 text-emerald-800 font-semibold">
                        <CheckCircle2 className="w-4 h-4 text-emerald-600" />
                        <span>Calibrated for {forecastResult.area}</span>
                      </div>
                      <div className="text-slate-800">
                        AQI Risk Tier: <strong className={`font-bold ${overallConfig.badgeText}`}>{forecastResult.category}</strong>
                      </div>
                    </div>
                  </div>
                </div>
              </motion.section>
            )}
          </main>
        )}

        {/* Minimal Footer */}
        <footer className="mt-12 text-center text-xs text-slate-800/80 border-t border-white/40 pt-6 font-mono font-medium drop-shadow-xs flex flex-col items-center justify-center gap-2.5">
          <div className="h-9 px-3 py-1 rounded-2xl bg-white/90 backdrop-blur-md border border-white/30 shadow-xs flex items-center justify-center">
            <img src="/logo.jpg" alt="AI AQI Predictor" className="h-6 w-auto object-contain mix-blend-multiply" />
          </div>
          <p className="font-semibold text-slate-800">AI AQI Predictor • Academic Environmental Engineering</p>
          <p className="text-slate-600">
            5 Time Slots / Day • 48-Hour Continuous Progression Curve & Dynamic Gesture Suite
          </p>
        </footer>

      </div>
    </div>
  );
}
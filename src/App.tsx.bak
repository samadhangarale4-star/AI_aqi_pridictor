                </section>

                {/* COLORFUL RECHARTS DATA VISUALIZATION SUITE */}
                <section className="bg-white/15 backdrop-blur-2xl rounded-3xl border border-white/30 p-5 sm:p-6 shadow-2xl shadow-sky-950/15">
                  <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5 pb-4 border-b border-white/30">
                    <div>
                      <h3 className="text-base font-extrabold uppercase tracking-wider text-slate-900 flex items-center gap-2">

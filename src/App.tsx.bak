              ].map((tab) => {
                const isActive = dashboardTab === tab.id;
                const Icon = tab.icon;
                return (
                  <motion.button
                    key={tab.id}
                    whileHover={{ scale: 1.02, y: -2 }}
                    whileTap={{ scale: 0.98 }}
                    type="button"
                    onClick={() => setDashboardTab(tab.id as any)}
                    className={`flex-1 min-w-[190px] sm:min-w-[210px] py-4 px-4 sm:py-5 sm:px-5 rounded-2xl sm:rounded-3xl flex flex-col justify-between gap-3 transition-all cursor-pointer text-left relative ${
                      isActive
                        ? 'bg-white text-slate-950 font-black shadow-2xl shadow-sky-950/25 ring-4 ring-white/80 scale-[1.02]'
                        : 'bg-white/15 hover:bg-white/30 text-slate-800 hover:text-slate-950 border border-white/25 hover:border-white/40 backdrop-blur-md'
                    }`}
                  >
                    <div className="flex items-center justify-between w-full">
                      <div className={`w-11 h-11 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center shrink-0 transition-all ${
                        isActive 

              title="Copy formatted forecast report to clipboard"
            >
              {copiedSuccess ? (
                <>
                  <Check className="w-3.5 h-3.5 text-emerald-600" />
                  <span className="text-emerald-700 font-semibold">Report Copied!</span>
                </>
              ) : (
                <>
                  <Copy className="w-3.5 h-3.5 text-slate-600" />
                  <span>Export Brief</span>
                </>
              )}
            </motion.button>
          )}
        </div>

        {/* BIG PROPER DASHBOARD TABS */}
        <div className="w-full mb-8">
          <div className="p-3 sm:p-4 rounded-3xl bg-white/20 backdrop-blur-2xl border-2 border-white/40 shadow-2xl shadow-sky-950/20">
            <div className="flex items-center gap-2.5 sm:gap-3.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
              {[
                { 
                  id: 'all', 
                  label: 'All Dashboard', 
                  desc: 'Complete 48h integrated suite', 
                  badge: 'Full Suite',
                  icon: Layers 
                },
                { 
                  id: 'analytics', 
                  label: 'Charts & Trends', 
                  desc: 'Recharts curves, diurnal & KPIs', 
                  badge: 'Curves & KPIs',

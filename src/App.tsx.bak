                },
                { 
                  id: 'scrubber', 
                  label: 'Timeline Scrubber', 
                  desc: '48h interactive gesture player', 
                  badge: 'Gesture Player',
                  icon: Hand 
                },
                { 
                  id: 'forecast', 
                  label: 'Hourly Forecast', 
                  desc: '48 time slots & sortable table', 
                  badge: 'Hourly Data',
                  icon: Calendar 
                },
                { 

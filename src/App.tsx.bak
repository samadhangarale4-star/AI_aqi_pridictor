import React, { useState, useEffect, useMemo, useRef } from 'react';
import { 
  AQI_CATEGORIES, 
  POLLUTANT_COLORS,
  POPULAR_AREAS, 
  generateForecast,
  generateWeeklyWeatherOutlook,
  WeekDayForecast 
} from './utils/aqi';
import { 
  WeatherIconMap, 
  RealisticSunIcon 
} from './components/WeatherIcons';
import { 
  AQICategory, 
  PredictionResult, 
  SimulationParams, 
  TimeSlotForecast 
} from './types';
import { 
  Wind, 
  Sparkles, 
  Search, 
  Clock, 
  Calendar, 
  ShieldCheck, 
  SlidersHorizontal,
  Copy,
  Check,
  ChevronDown,
  ChevronUp,
  RefreshCw,
  Gauge,
  Thermometer,
  Droplets,
  Layers,
  TrendingDown,
  TrendingUp,
  Activity,
  BarChart3,
  LineChart as LineChartIcon,
  Sun,
  Flame,
  CheckCircle2,
  Play,
  Pause,
  RotateCcw,
  Hand,
  ArrowRight,
  ArrowLeft,
  Cloud,
  MapPin
} from 'lucide-react';
import { CloudShader } from '@/components/ui/cloud-shader';
import {
  ResponsiveContainer,
  AreaChart,
  Area,
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ReferenceLine,
  Legend
} from 'recharts';
import { motion, AnimatePresence } from 'motion/react';

interface ChartPoint {
  slotId: string;
  dayIndex: number;
  dayLabel: string;
  time: string;
  fullLabel: string;
  shortLabel: string;
  aqi: number;
  category: AQICategory;
  pollutant: string;
  temperature: string;
  humidity: string;
  windSpeed: string;
  note: string;
}

export default function App() {
  const [selectedArea, setSelectedArea] = useState<string>('Central Downtown');
  const [customInput, setCustomInput] = useState<string>('Central Downtown');
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [forecastResult, setForecastResult] = useState<PredictionResult | null>(null);
  
  // Interactive UI States
  const [viewMode, setViewMode] = useState<'cards' | 'table'>('cards');
  const [activeDayFilter, setActiveDayFilter] = useState<'both' | 0 | 1>('both');
  const [selectedSlot, setSelectedSlot] = useState<TimeSlotForecast | null>(null);
  const [highlightCategory, setHighlightCategory] = useState<AQICategory | null>(null);
  const [showSimControls, setShowSimControls] = useState<boolean>(false);
  const [copiedSuccess, setCopiedSuccess] = useState<boolean>(false);
  const [cloudSpeed, setCloudSpeed] = useState<number>(0.8);
  const [activeChartTab, setActiveChartTab] = useState<'timeline' | 'diurnal' | 'pollutants'>('timeline');
  const [dashboardTab, setDashboardTab] = useState<'all' | 'analytics' | 'scrubber' | 'forecast' | 'advisory'>('all');

  // Dynamic Scrubber & Timeline Player
  const [scrubberIndex, setScrubberIndex] = useState<number>(0);
  const [isPlayingTimeline, setIsPlayingTimeline] = useState<boolean>(false);
  const timerRef = useRef<NodeJS.Timeout | null>(null);

  // Environmental simulation parameters
  const [simParams, setSimParams] = useState<SimulationParams>({
    windDispersion: 'normal',
    trafficProfile: 'standard',
  });

  // 7-Day Weather Outlook State matching reference UI
  const [selectedWeekDayIndex, setSelectedWeekDayIndex] = useState<number>(0);
  const [liveTime, setLiveTime] = useState<string>(() => {
    const d = new Date();
    const hrs = d.getHours().toString().padStart(2, '0');
    const mins = d.getMinutes().toString().padStart(2, '0');
    return `${hrs}:${mins}`;
  });

  useEffect(() => {
    const timer = setInterval(() => {
      const d = new Date();
      const hrs = d.getHours().toString().padStart(2, '0');
      const mins = d.getMinutes().toString().padStart(2, '0');
      setLiveTime(`${hrs}:${mins}`);
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  // Execute prediction
  const handlePredict = async (
    areaToPredict?: string,
    currentParams: SimulationParams = simParams
  ) => {
    const targetArea = (areaToPredict || customInput).trim() || 'Central Urban Area';
    setIsLoading(true);

    const basePrediction = generateForecast(targetArea, currentParams);

    let recommendationText = '';
    let recommendationSource: 'ai' | 'standard' = 'standard';

    try {
      const timeSlotsSummary = basePrediction.days
        .map((d) => `${d.dayTitle}: Avg ${d.averageAqi}, Peak ${d.peakAqi} (${d.category})`)
        .join('; ');

      const response = await fetch('/api/recommendation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          area: targetArea,
          peakAqi: basePrediction.peakAqi,
          avgAqi: basePrediction.overallAqi,
          category: basePrediction.category,
          timeSlotsSummary,
        }),
      });

      if (response.ok) {
        const data = await response.json();
        recommendationText = data.recommendation;
        recommendationSource = data.source || 'ai';
      }
    } catch {
      // Handled gracefully with deterministic advisory
    }

    if (!recommendationText) {
      if (basePrediction.overallAqi <= 50) {
        recommendationText = 'Air quality is satisfactory across the 48-hour horizon. Normal outdoor activity, natural building ventilation, and physical recreation can proceed without restrictions.';
      } else if (basePrediction.overallAqi <= 100) {
        recommendationText = 'Air quality remains acceptable for the general public. Sensitive individuals with chronic respiratory conditions should monitor morning and evening peak traffic hours.';
      } else if (basePrediction.overallAqi <= 150) {
        recommendationText = 'Vulnerable demographics (children, elderly, asthmatics) should moderate intense outdoor exertion. Close windows during morning (10 AM) and evening (6 PM) commute peaks.';
      } else if (basePrediction.overallAqi <= 200) {
        recommendationText = 'Elevated particulate concentration expected. Sensitive groups should avoid outdoor exertion; general population should wear certified particulate filtration (N95) outdoors.';
      } else {
        recommendationText = 'High particulate alert. All individuals are advised to remain indoors, activate HEPA filtration systems, and suspend all outdoor strenuous cardiovascular activities.';
      }
    }

    setForecastResult({
      ...basePrediction,
      recommendation: recommendationText,
      recommendationSource,
    });

    setSelectedArea(targetArea);
    setCustomInput(targetArea);
    
    // Select peak slot
    const firstDayPeak = basePrediction.days[0].timeSlots.reduce((prev, curr) => 
      curr.aqi > prev.aqi ? curr : prev
    );
    setSelectedSlot(firstDayPeak);
    setScrubberIndex(0);
    setIsPlayingTimeline(false);
    setIsLoading(false);
  };

  useEffect(() => {
    handlePredict('Central Downtown');
  }, []);

  // Transform 48-Hour Continuous Timeline for Recharts & Scrubber
  const timelineChartData = useMemo<ChartPoint[]>(() => {
    if (!forecastResult) return [];
    const points: ChartPoint[] = [];

    forecastResult.days.forEach((day, dayIndex) => {
      day.timeSlots.forEach((slot) => {
        points.push({
          slotId: slot.id,
          dayIndex,
          dayLabel: dayIndex === 0 ? 'Day 1' : 'Day 2',
          time: slot.time,
          fullLabel: `${dayIndex === 0 ? 'Day 1' : 'Day 2'} • ${slot.time}`,
          shortLabel: `${dayIndex === 0 ? 'D1' : 'D2'} ${slot.time.replace(':00 ', '')}`,
          aqi: slot.aqi,
          category: slot.category,
          pollutant: slot.mainPollutant,
          temperature: slot.temperature,
          humidity: slot.humidity,
          windSpeed: slot.windSpeed,
          note: slot.hourlyNote,
        });
      });
    });

    return points;
  }, [forecastResult]);

  // Scrub timeline automatically when play is active
  useEffect(() => {
    if (isPlayingTimeline && timelineChartData.length > 0) {
      timerRef.current = setInterval(() => {
        setScrubberIndex((prev) => {
          const next = (prev + 1) % timelineChartData.length;
          const activePoint = timelineChartData[next];
          if (activePoint && forecastResult) {
            const slot = forecastResult.days[activePoint.dayIndex]?.timeSlots.find(
              (s) => s.id === activePoint.slotId
            );
            if (slot) setSelectedSlot(slot);
          }
          return next;
        });
      }, 1500);
    } else {
      if (timerRef.current) clearInterval(timerRef.current);
    }

    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, [isPlayingTimeline, timelineChartData, forecastResult]);

  // Handle manual scrubber selection
  const handleScrubberChange = (index: number) => {
    setScrubberIndex(index);
    if (timelineChartData[index] && forecastResult) {
      const activePoint = timelineChartData[index];
      const slot = forecastResult.days[activePoint.dayIndex]?.timeSlots.find(
        (s) => s.id === activePoint.slotId
      );
      if (slot) setSelectedSlot(slot);
    }
  };

  // Sync selectedSlot to scrubberIndex when user clicks a card or table row
  const handleSelectSlot = (slot: TimeSlotForecast) => {
    setSelectedSlot(slot);
    const idx = timelineChartData.findIndex((p) => p.slotId === slot.id);
    if (idx !== -1) setScrubberIndex(idx);
  };

  // Swipe gesture navigation between Day 1 and Day 2
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const handleSwipeEnd = (_e: any, info: { offset: { x: number; y: number }; velocity: { x: number } }) => {
    const swipeThreshold = 50;
    if (info.offset.x < -swipeThreshold || info.velocity.x < -300) {
      // Swiped left -> Go to Day 2 or Both
      if (activeDayFilter === 'both') setActiveDayFilter(0);
      else if (activeDayFilter === 0) setActiveDayFilter(1);
    } else if (info.offset.x > swipeThreshold || info.velocity.x > 300) {
      // Swiped right -> Go to Day 1 or Both
      if (activeDayFilter === 1) setActiveDayFilter(0);
      else if (activeDayFilter === 0) setActiveDayFilter('both');
    }
  };

  // Copy structured forecast report to clipboard
  const handleCopyReport = () => {
    if (!forecastResult) return;
    const lines = [
      `=== AIR QUALITY PREDICTION REPORT ===`,
      `Target Area: ${forecastResult.area}`,
      `Prediction Timestamp: ${forecastResult.predictedAt}`,
      `Overall 48h Mean AQI: ${forecastResult.overallAqi} (${forecastResult.category})`,
      `Peak Predicted AQI: ${forecastResult.peakAqi}`,
      ``,
      ...forecastResult.days.map((day) => {
        return [
          `[${day.dayTitle} - ${day.dateFormatted}] (Day Mean: ${day.averageAqi} AQI)`,
          ...day.timeSlots.map((s) => `  - ${s.time.padEnd(8)}: ${s.aqi} AQI [${s.category}] | Primary: ${s.mainPollutant} | ${s.temperature}`),
          ``
        ].join('\n');
      }),
      `Advisory: ${forecastResult.recommendation}`,
    ];
    navigator.clipboard.writeText(lines.join('\n'));
    setCopiedSuccess(true);
    setTimeout(() => setCopiedSuccess(false), 2200);
  };

  const overallConfig = forecastResult ? AQI_CATEGORIES[forecastResult.category] : null;

  // 7-Day Weather Outlook matching reference UI
  const weeklyOutlook = useMemo<WeekDayForecast[]>(() => {
    return generateWeeklyWeatherOutlook(selectedArea || 'CITY', forecastResult?.overallAqi || 65);
  }, [selectedArea, forecastResult]);

  const activeWeekDay = weeklyOutlook[selectedWeekDayIndex] || weeklyOutlook[0];

  // Filtered days based on active tab
  const displayedDays = useMemo(() => {
    if (!forecastResult) return [];
    if (activeDayFilter === 0) return [forecastResult.days[0]];
    if (activeDayFilter === 1) return [forecastResult.days[1]];
    return forecastResult.days;
  }, [forecastResult, activeDayFilter]);

  // Diurnal 5 Time-Slots Comparison Data (Day 1 vs Day 2)
  const diurnalComparisonData = useMemo(() => {
    if (!forecastResult || forecastResult.days.length < 2) return [];
    const day1Slots = forecastResult.days[0].timeSlots;
    const day2Slots = forecastResult.days[1].timeSlots;

    return day1Slots.map((slot, index) => ({
      time: slot.time,
      day1Aqi: slot.aqi,
      day2Aqi: day2Slots[index]?.aqi ?? slot.aqi,
      pollutant: slot.mainPollutant,
    }));
  }, [forecastResult]);

  // Pollutant Share & Average AQI by Pollutant
  const pollutantAnalyticsData = useMemo(() => {
    if (!forecastResult) return [];
    const counts: Record<string, { count: number; totalAqi: number }> = {};
    
    forecastResult.days.forEach((day) => {
      day.timeSlots.forEach((slot) => {
        if (!counts[slot.mainPollutant]) {
          counts[slot.mainPollutant] = { count: 0, totalAqi: 0 };
        }
        counts[slot.mainPollutant].count += 1;
        counts[slot.mainPollutant].totalAqi += slot.aqi;
      });
    });

    return Object.entries(counts).map(([name, stat]) => ({
      pollutant: name,
      frequency: stat.count,
      avgAqi: Math.round(stat.totalAqi / stat.count),
      fillColor: POLLUTANT_COLORS[name]?.fill || '#64748b',
    }));
  }, [forecastResult]);

  // Comprehensive Analytics Metrics
  const analyticsSummary = useMemo(() => {
    if (!forecastResult) return null;
    const allSlots = forecastResult.days.flatMap((d) => d.timeSlots);
    
    const peakSlot = allSlots.reduce((max, s) => (s.aqi > max.aqi ? s : max), allSlots[0]);
    const cleanestSlot = allSlots.reduce((min, s) => (s.aqi < min.aqi ? s : min), allSlots[0]);

    const safeSlots = allSlots.filter((s) => s.aqi <= 100).length;
    const safePercentage = Math.round((safeSlots / allSlots.length) * 100);

    const day1Avg = forecastResult.days[0]?.averageAqi || 0;
    const day2Avg = forecastResult.days[1]?.averageAqi || 0;
    const diffPct = Math.round(((day2Avg - day1Avg) / (day1Avg || 1)) * 100);

    return {
      peakSlot,
      cleanestSlot,
      safePercentage,
      safeSlotsCount: safeSlots,
      totalSlots: allSlots.length,
      day1Avg,
      day2Avg,
      diffPct,
    };
  }, [forecastResult]);

  const activeScrubPoint = timelineChartData[scrubberIndex] || timelineChartData[0];
  const activeScrubConfig = activeScrubPoint ? AQI_CATEGORIES[activeScrubPoint.category] : null;

  // Custom Chart Tooltip
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const CustomTimelineTooltip = ({ active, payload }: any) => {
    if (active && payload && payload.length) {
      const data = payload[0].payload as ChartPoint;
      const catConfig = AQI_CATEGORIES[data.category];
      const pollConfig = POLLUTANT_COLORS[data.pollutant] || { bg: 'bg-slate-100', text: 'text-slate-800' };

      return (
        <div className="bg-white/80 backdrop-blur-2xl p-3.5 rounded-2xl border border-white/40 shadow-2xl text-xs font-sans min-w-[210px]">
          <div className="font-mono text-slate-600 text-[11px] font-semibold border-b border-white/30 pb-1.5 mb-2 flex items-center justify-between">
            <span className="font-bold text-slate-800">{data.fullLabel}</span>
            <span className={`px-1.5 py-0.5 rounded text-[10px] font-bold ${pollConfig.bg} ${pollConfig.text}`}>
              {data.pollutant}
            </span>
          </div>
          <div className="flex items-baseline justify-between mb-2">
            <span className="text-slate-700 font-medium">Predicted Value:</span>
            <span className="font-mono text-lg font-extrabold text-slate-900">{data.aqi} AQI</span>
          </div>
          <div className={`px-2.5 py-1 rounded-md border flex items-center gap-1.5 font-bold text-xs mb-2 ${catConfig.badgeBg} ${catConfig.badgeBorder} ${catConfig.badgeText}`}>
            <span className={`w-2 h-2 rounded-full ${catConfig.dotColor}`} />
            <span>{data.category}</span>
          </div>
          <div className="pt-2 border-t border-white/30 text-[11px] text-slate-700 font-mono space-y-1">
            <div className="flex justify-between">
              <span>Temperature:</span>
              <strong className="text-slate-900">{data.temperature}</strong>
            </div>
            <div className="flex justify-between">
              <span>Wind Speed:</span>
              <strong className="text-slate-900">{data.windSpeed}</strong>
            </div>
            <div className="flex justify-between">
              <span>Rel. Humidity:</span>
              <strong className="text-slate-900">{data.humidity}</strong>
            </div>
          </div>
        </div>
      );
    }
    return null;
  };

  return (
    <div className="min-h-screen relative text-white antialiased font-sans selection:bg-sky-400 selection:text-slate-900">
      
      {/* Fullscreen Fixed Procedural Cloud Shader Background matching daylight sky */}
      <div className="fixed inset-0 -z-20 pointer-events-none overflow-hidden">
        <CloudShader 
          className="w-full h-full min-h-screen" 
          speed={cloudSpeed} 
          count={6}
          cloudColor="#ffffff"
          skyTopColor="#1d5cb6"
          skyBottomColor="#79b4ed"
        />
        {/* Subtle glass refraction tint */}
        <div className="absolute inset-0 bg-blue-950/15 backdrop-blur-[0.5px] pointer-events-none" />
      </div>

      {/* Clean Transparent Floating Top Bar */}
      <nav className="w-full sticky top-0 z-40 bg-transparent px-4 py-3 sm:px-8">
        <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
          
          {/* Official AI AQI Predictor Logo Badge */}
          <div className="flex items-center gap-2.5 shrink-0">
            <div className="h-9 sm:h-10 px-2.5 py-1 rounded-2xl bg-white/95 backdrop-blur-xl border border-white/40 shadow-sm flex items-center justify-center transition-all hover:bg-white hover:scale-[1.02]">
              <img 
                src="/logo.jpg" 
                alt="AI AQI Predictor" 
                className="h-6 sm:h-7 w-auto object-contain mix-blend-multiply" 
              />
            </div>
          </div>

          {/* Clean Rounded-Full Search Input */}
          <form 
            onSubmit={(e) => {
              e.preventDefault();
              handlePredict(customInput);
            }} 
            className="flex items-center gap-2 w-full md:w-auto flex-1 max-w-md"
          >
            <div className="relative flex-1 flex items-center bg-white/10 hover:bg-white/15 focus-within:bg-white/20 backdrop-blur-xl border border-white/20 rounded-full px-3.5 py-1.5 shadow-sm transition-all">
              <Search className="w-4 h-4 text-white/70 mr-2 shrink-0 pointer-events-none" />
              <input
                id="area-input"
                type="text"
                value={customInput}
                onChange={(e) => setCustomInput(e.target.value)}
                placeholder="Search city or sensor station..."
                className="w-full bg-transparent text-xs sm:text-sm text-white placeholder-white/60 focus:outline-none font-sans"
              />
            </div>
            <motion.button
              whileHover={{ scale: 1.04 }}
              whileTap={{ scale: 0.95 }}
              type="submit"
              disabled={isLoading}
              className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/15 hover:bg-white/25 active:bg-white/35 border border-white/25 text-white text-xs font-semibold transition-all shadow-sm cursor-pointer shrink-0 backdrop-blur-md"
            >
              {isLoading ? <RefreshCw className="w-3.5 h-3.5 animate-spin" /> : <Activity className="w-3.5 h-3.5" />}
              <span>{isLoading ? 'Loading...' : 'Forecast'}</span>
            </motion.button>
          </form>

          {/* Quick Preset Chips - Sleek Translucent Pills */}
          <div className="hidden lg:flex items-center gap-1.5 text-[11px] overflow-x-auto max-w-sm">
            {POPULAR_AREAS.slice(0, 4).map((preset) => {
              const isSelected = selectedArea.toLowerCase() === preset.toLowerCase();
              return (
                <button
                  key={preset}
                  type="button"
                  onClick={() => {
                    setCustomInput(preset);
                    handlePredict(preset);
                  }}
                  className={`px-3 py-1 rounded-full border text-xs transition-all cursor-pointer font-medium backdrop-blur-md truncate ${
                    isSelected
                      ? 'bg-white text-slate-900 border-white shadow-sm font-semibold'
                      : 'bg-white/10 text-white/90 border-white/20 hover:bg-white/20'
                  }`}
                >
                  {preset}
                </button>
              );
            })}
          </div>

          {/* Clean Controls - Translucent Pills */}
          <div className="flex items-center gap-2 shrink-0">
            <motion.button
              whileHover={{ scale: 1.04 }}
              whileTap={{ scale: 0.96 }}
              type="button"
              onClick={() => setCloudSpeed((prev) => (prev === 0.7 ? 1.5 : prev === 1.5 ? 0 : 0.7))}
              className="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border border-white/20 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white transition-all cursor-pointer font-medium"
              title="Adjust cloud speed"
            >
              <Cloud className="w-3.5 h-3.5 text-sky-200" />
              <span>Sky: {cloudSpeed === 0 ? 'Paused' : cloudSpeed === 0.7 ? 'Drift' : 'Fast'}</span>
            </motion.button>

            <motion.button
              whileHover={{ scale: 1.04 }}
              whileTap={{ scale: 0.96 }}
              type="button"
              onClick={() => setShowSimControls(!showSimControls)}
              className={`inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border font-medium transition-all cursor-pointer backdrop-blur-md ${
                showSimControls
                  ? 'bg-white text-slate-900 border-white ring-2 ring-white/50 font-semibold'
                  : 'bg-white/10 text-white border-white/20 hover:bg-white/20'
              }`}
            >
              <SlidersHorizontal className="w-3.5 h-3.5" />
              <span>Simulation</span>
              {showSimControls ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
            </motion.button>

            <a
              href="#analytics-suite"
              className="inline-flex items-center gap-1.5 text-xs px-3.5 py-1.5 rounded-full bg-white/15 hover:bg-white/25 border border-white/25 text-white font-semibold transition-all shadow-xs backdrop-blur-md"
            >
              <BarChart3 className="w-3.5 h-3.5" />
              <span className="hidden sm:inline">Analytics & AI</span>
              <span>↓</span>
            </a>
          </div>
        </div>

        {/* Clean Simulation Factors Drawer */}
        <AnimatePresence>
          {showSimControls && (
            <motion.div
              initial={{ opacity: 0, height: 0 }}
              animate={{ opacity: 1, height: 'auto' }}
              exit={{ opacity: 0, height: 0 }}
              transition={{ duration: 0.25 }}
              className="max-w-6xl mx-auto overflow-hidden pt-2"
            >
              <div className="mt-2 p-4 rounded-3xl bg-blue-950/35 backdrop-blur-2xl border border-white/25 text-xs text-white shadow-2xl">
                <div className="flex items-center justify-between mb-2">
                  <span className="font-bold flex items-center gap-2 text-white">
                    <SlidersHorizontal className="w-4 h-4 text-sky-300" />
                    Atmospheric Dispersion & Traffic Simulation
                  </span>
                  <span className="text-[10px] text-white/80 bg-white/10 px-2 py-0.5 rounded-full border border-white/20">
                    Live Feedback
                  </span>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label className="block text-white/80 font-medium mb-1 text-[11px]">
                      Wind & Dispersion Mode
                    </label>
                    <div className="grid grid-cols-3 gap-1.5">
                      {(['calm', 'normal', 'breezy'] as const).map((mode) => (
                        <button
                          key={mode}
                          type="button"
                          onClick={() => {
                            const updated = { ...simParams, windDispersion: mode };
                            setSimParams(updated);
                            handlePredict(customInput, updated);
                          }}
                          className={`py-1 px-2 rounded-lg border text-center capitalize transition-all cursor-pointer font-medium text-xs ${
                            simParams.windDispersion === mode
                              ? 'bg-white text-slate-900 border-white font-bold shadow-sm'
                              : 'bg-white/10 text-white border-white/20 hover:bg-white/20'
                          }`}
                        >
                          {mode}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div>
                    <label className="block text-white/80 font-medium mb-1 text-[11px]">
                      Traffic & Urban Emission Profile
                    </label>
                    <div className="grid grid-cols-3 gap-1.5">
                      {(['reduced', 'standard', 'heavy'] as const).map((mode) => (
                        <button
                          key={mode}
                          type="button"
                          onClick={() => {
                            const updated = { ...simParams, trafficProfile: mode };
                            setSimParams(updated);
                            handlePredict(customInput, updated);
                          }}
                          className={`py-1 px-2 rounded-lg border text-center capitalize transition-all cursor-pointer font-medium text-xs ${
                            simParams.trafficProfile === mode
                              ? 'bg-white text-slate-900 border-white font-bold shadow-sm'
                              : 'bg-white/10 text-white border-white/20 hover:bg-white/20'
                          }`}
                        >
                          {mode}
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </nav>

      {/* ============================================================== */}
      {/* HERO WEATHER SKY VIEWPORT - REPLICATING THE REFERENCE DESIGN   */}
      {/* ============================================================== */}
      <section className="relative w-full max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-12 sm:pt-12 sm:pb-16 flex flex-col justify-between min-h-[580px] sm:min-h-[660px]">
        
        {/* RADIANT GOLDEN SUN (Top Center behind billow clouds) */}
        <div className="absolute left-1/2 top-4 sm:top-6 -translate-x-1/2 pointer-events-none -z-10 flex flex-col items-center">
          <div className="relative w-72 h-72 sm:w-96 sm:h-96 flex items-center justify-center">
            {/* Luminous corona bloom aura */}
            <div className="absolute w-64 h-64 sm:w-80 sm:h-80 rounded-full bg-gradient-to-tr from-yellow-300/40 via-amber-400/50 to-orange-400/30 blur-3xl animate-pulse" />
            {/* Golden Core Sun disk */}
            <div className="w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-gradient-to-br from-yellow-100 via-amber-300 to-amber-500 shadow-[0_0_90px_40px_rgba(251,191,36,0.75)]" />
            {/* Soft radial sunbeam lens rays */}
            <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-yellow-100/45 via-amber-200/15 to-transparent scale-125 pointer-events-none" />
          </div>
        </div>

        {/* Ambient lens flare bokeh circles */}
        <div className="absolute top-12 left-8 w-20 h-20 rounded-full bg-white/10 blur-xl pointer-events-none" />
        <div className="absolute top-36 left-1/3 w-32 h-32 rounded-full bg-sky-200/15 blur-2xl pointer-events-none" />
        <div className="absolute top-24 right-1/4 w-24 h-24 rounded-full bg-white/10 blur-xl pointer-events-none" />

        {/* TOP HERO ROW: Left (City, Date, Clock, Condition) | Right (Atmospheric Data, +20°C) */}
        <div className="flex flex-col sm:flex-row items-start sm:items-start justify-between gap-6 relative z-10">
          
          {/* Top Left: Location Pin, Date, Huge Clock, Weather Condition */}
          <div className="flex flex-col items-start select-none">
            {/* Location with Pin */}
            <div className="inline-flex items-center gap-1.5 text-white drop-shadow-md">
              <MapPin className="w-4 h-4 sm:w-5 sm:h-5 text-white" />
              <span className="text-sm sm:text-base font-medium tracking-widest uppercase">
                {selectedArea || 'CITY'}
              </span>
            </div>

            {/* Date in uppercase clean typography */}
            <div className="text-xl sm:text-2xl md:text-3xl font-normal tracking-wide text-white drop-shadow-md mt-1 uppercase">
              {activeWeekDay.dateFormatted}
            </div>

            {/* Huge Digital Clock */}
            <div className="text-7xl sm:text-8xl md:text-9xl font-extralight tracking-tight text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.35)] -my-1 sm:-my-2 font-mono">
              {liveTime}
            </div>

            {/* Weather Condition */}
            <div className="text-lg sm:text-2xl font-light tracking-widest text-white/95 uppercase drop-shadow-md mt-1">
              {activeWeekDay.conditionLabel}
            </div>
          </div>

          {/* Top Right: Atmospheric Metrics & Large Temperature */}
          <div className="flex flex-col items-start sm:items-end text-left sm:text-right select-none sm:self-start">
            {/* Metrics stack */}
            <div className="space-y-0.5 text-xs sm:text-sm font-light tracking-widest text-white/95 drop-shadow-md uppercase">
              <div>PRESSURE: {activeWeekDay.pressureHpa}hPA</div>
              <div>SUNRISE: {activeWeekDay.sunrise}</div>
              <div>SUNSET: {activeWeekDay.sunset}</div>
              <div className="text-[11px] text-white/80 font-mono pt-1">
                AQI: <strong className="text-white font-bold">{activeWeekDay.aqi}</strong> ({activeWeekDay.category})
              </div>
            </div>

            {/* Large Hero Temperature */}
            <div className="text-7xl sm:text-8xl md:text-9xl font-extralight tracking-tight text-white drop-shadow-[0_4px_16px_rgba(0,0,0,0.35)] mt-1 font-mono">
              +{activeWeekDay.currentTemp}°C
            </div>
          </div>
        </div>

        {/* BOTTOM ROW: Exactly 7 Horizontal Glass Cards matching reference image */}
        <div className="w-full mt-12 sm:mt-16 pt-4 relative z-10">
          <div className="grid grid-cols-7 gap-2 sm:gap-3.5 w-full">
            {weeklyOutlook.map((day, idx) => {
              const isSelected = idx === selectedWeekDayIndex;
              const WeatherIconComp = WeatherIconMap[day.weatherType] || RealisticSunIcon;

              return (
                <motion.button
                  key={day.id}
                  whileHover={{ y: -4, scale: 1.02 }}
                  whileTap={{ scale: 0.98 }}
                  type="button"
                  onClick={() => setSelectedWeekDayIndex(idx)}
                  className={`relative rounded-xl sm:rounded-2xl py-4 sm:py-5 px-1.5 sm:px-3 flex flex-col justify-between items-center text-center cursor-pointer transition-all min-h-[180px] sm:min-h-[230px] ${
                    isSelected
                      ? 'bg-blue-900/65 ring-2 ring-white/90 shadow-[0_0_25px_rgba(255,255,255,0.3)] backdrop-blur-2xl'
                      : 'bg-blue-950/40 hover:bg-blue-900/55 border border-white/20 backdrop-blur-xl'
                  }`}
                >
                  {/* Day Header */}
                  <div className="text-xs sm:text-sm md:text-base font-medium tracking-wider text-white uppercase drop-shadow-sm">
                    {day.dayShort}
                  </div>

                  {/* Realistic Weather SVG Graphic */}
                  <div className="my-auto py-2 flex items-center justify-center">
                    <WeatherIconComp size={48} className="drop-shadow-lg scale-100 sm:scale-110" />
                  </div>

                  {/* High and Low Temperature numbers */}
                  <div className="space-y-0.5 font-light tracking-tight text-white">
                    <div className="text-base sm:text-xl md:text-2xl drop-shadow-sm font-normal">
                      {day.highTemp}°C
                    </div>
                    <div className="text-xs sm:text-base md:text-lg text-white/80 drop-shadow-sm">
                      {day.lowTemp}°C
                    </div>
                  </div>
                </motion.button>
              );
            })}
          </div>
        </div>

      </section>

      {/* ============================================================== */}
      {/* DEEP-DIVE ATMOSPHERIC & AQI ANALYTICS SUITE (Below Hero)       */}
      {/* ============================================================== */}
      <div id="analytics-suite" className="max-w-5xl mx-auto px-4 py-8 sm:px-6 sm:py-12 relative z-10 text-slate-900">
        
